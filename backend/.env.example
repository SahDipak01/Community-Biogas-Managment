PORT=5000
NODE_ENV=development
# Set your MongoDB URI here. If left default or if local mongod is not running,
# the server will automatically use an in-memory MongoDB instance for zero-setup local demonstration!
MONGODB_URI=mongodb://127.0.0.1:27017/biogas_db
JWT_SECRET=your_secure_jwt_secret_key_change_in_production
JWT_EXPIRE=30d
