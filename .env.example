# ==========================================
# RURAL COMMUNITY BIOGAS SYSTEM ENVIRONMENT
# ==========================================

# Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# If local MongoDB is not running or unconfigured, the system automatically 
# starts an in-memory MongoDB instance with pre-seeded data for instant evaluation!
MONGODB_URI=mongodb://127.0.0.1:27017/biogas_db

# JWT Security Secrets
JWT_SECRET=rural_biogas_jwt_super_secure_secret_key_2026
JWT_EXPIRE=30d

# Frontend Configuration (optional override)
VITE_API_BASE_URL=/api
